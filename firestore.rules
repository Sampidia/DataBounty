rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection (Testers & Creators)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Tasks Collection (Google Forms, App Tests, Web Bugs)
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Withdrawals Collection (Tester Cashout Requests & Admin Queue)
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }
  }
}
